# -----------------------------------------------------------------------------
# Frontend (expostas ao navegador — use SOMENTE a chave pública "anon")
# Supabase > Project Settings > API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL pública usada no QR Code de presença (opcional).
# Se vazia, usa a origem atual do navegador (window.location.origin).
VITE_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# SOMENTE para o script local scripts/create-demo-users.mjs (npm run demo:users)
# NUNCA prefixe com VITE_ e NUNCA configure na Vercel: a service_role ignora RLS.
# Coloque estas variáveis em .env.local (ignorado pelo Git).
# -----------------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=
