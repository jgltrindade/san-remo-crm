# -----------------------------------------------------------------------------
# Frontend (vão para o navegador — use SOMENTE a chave pública)
# Supabase > Project Settings > API Keys (ou botão "Connect" no topo do painel)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Projetos novos: "Publishable key" (começa com sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Projetos antigos: "anon key" (começa com eyJ). Use uma OU outra.
VITE_SUPABASE_ANON_KEY=

# URL pública usada no QR Code de presença (opcional).
# Se vazia, usa a origem atual do navegador (window.location.origin).
VITE_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# SOMENTE para o script local scripts/create-demo-users.mjs (npm run demo:users)
# NUNCA prefixe com VITE_ e NUNCA configure na Vercel: esta chave ignora RLS.
# Projetos novos: "Secret key" (sb_secret_...). Antigos: "service_role key".
# -----------------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=
DEMO_PASSWORD=
